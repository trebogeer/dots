#!/bin/bash

set -e

# ============================================================
# Minimal Ubuntu Server + i3
#
# This script INSTALLS packages only.
# It does NOT create or modify your i3 configuration.
# ============================================================

if [ "$EUID" -ne 0 ]; then
    echo
    echo "Run this script with:"
    echo
    echo "    sudo $0"
    echo
    exit 1
fi

# ------------------------------------------------------------
# Determine normal user
# ------------------------------------------------------------

REAL_USER="${SUDO_USER:-}"

if [ -z "$REAL_USER" ] || [ "$REAL_USER" = "root" ]; then
    REAL_USER=$(awk -F: '$3 >= 1000 && $3 < 60000 {print $1; exit}' /etc/passwd)
fi

if [ -z "$REAL_USER" ]; then
    echo "ERROR: Could not determine normal user."
    exit 1
fi

REAL_HOME=$(getent passwd "$REAL_USER" | cut -d: -f6)
REAL_GROUP=$(id -gn "$REAL_USER")

echo
echo "============================================================"
echo " Minimal Ubuntu + i3 installation"
echo "============================================================"
echo
echo "User: $REAL_USER"
echo "Home: $REAL_HOME"
echo

# ------------------------------------------------------------
# Update package lists
# ------------------------------------------------------------

echo "==> Updating package lists..."

apt-get update

# ------------------------------------------------------------
# Xorg
# ------------------------------------------------------------

echo
echo "==> Installing Xorg..."

apt-get install -y --no-install-recommends \
    xorg \
    xinit

# ------------------------------------------------------------
# i3
# ------------------------------------------------------------

echo
echo "==> Installing i3..."

apt-get install -y --no-install-recommends \
    i3 \
    i3status \
    i3lock

# ------------------------------------------------------------
# urxvt + urxvtd
#
# rxvt-unicode provides:
#   /usr/bin/urxvt     terminal
#   /usr/bin/urxvtc    client (spawns urxvt via the daemon)
#   /usr/bin/urxvtd    daemon
#   /usr/lib/<triplet>/urxvt/perl/   bundled perl extensions
#
# The daemon keeps a control socket at:
#   $HOME/.urxvt/urxvtd-<nodename>
#
# It is started from ~/.xinitrc with:
#   urxvtd -q -o -f
#     -q  quiet
#     -o  open a connection to $DISPLAY and keep it open
#     -f  fork into the background after binding the socket
#
# Terminal resources (font, transparency, colors) live in
# ~/.Xdefaults and are loaded into the X server by "xrdb" from
# ~/.xinitrc.  Without that, urxvt falls back to its built-in
# defaults and ~/.Xdefaults is silently ignored.
# ------------------------------------------------------------

echo
echo "==> Installing urxvt + urxvtd..."

apt-get install -y --no-install-recommends \
    rxvt-unicode

# ------------------------------------------------------------
# urxvtd runtime directory
#
# urxvtd creates $HOME/.urxvt itself, but it must be owned by
# the real user and not readable by anyone else (it holds a
# control socket).
# ------------------------------------------------------------

echo
echo "==> Preparing urxvtd runtime directory..."

install -d -m 700 -o "$REAL_USER" -g "$REAL_GROUP" "$REAL_HOME/.urxvt"

# The perl extension library can be overridden per user.  The
# system one shipped with rxvt-unicode is used by default, so
# only create the directory if a custom one is wanted.
#
#   sudo -u "$REAL_USER" mkdir -p "$REAL_HOME/.urxvt/perl"
#
# Note: rxvt-unicode 9.31 (Ubuntu 26.04) no longer ships the
# "clipboard" and "keyboard-select" perl extensions.  Use
# "clipboard-osc", "selection" or "selection-to-clipboard"
# instead.  ~/.Xdefaults is updated accordingly.

if ! command -v urxvtd >/dev/null 2>&1; then
    echo "WARNING: urxvtd not found, urxvt daemon will not start."
fi

# ------------------------------------------------------------
# urxvtd systemd user unit
#
# The daemon is started by a systemd user unit, not by
# ~/.xinitrc.  Only one of the two may start it, otherwise two
# daemons fight over the same control socket.
#
# The unit comes from the dotfiles repo.  If it is not there
# yet, a minimal one is written so urxvt works right away.
# ------------------------------------------------------------

echo
echo "==> Installing urxvtd systemd user unit..."

URXVTD_UNIT="$REAL_HOME/.config/systemd/user/urxvtd.service"

install -d -m 755 -o "$REAL_USER" -g "$REAL_GROUP" \
    "$REAL_HOME/.config/systemd/user"

if [ -f "$REAL_HOME/dots/.config/systemd/user/urxvtd.service" ]; then

    install -m 644 -o "$REAL_USER" -g "$REAL_GROUP" \
        "$REAL_HOME/dots/.config/systemd/user/urxvtd.service" \
        "$URXVTD_UNIT"

else

    cat > "$URXVTD_UNIT" << 'UNIT'
[Unit]
Description=urxvt terminal daemon
Documentation=man:urxvtd(1)

[Service]
Type=simple
ExecStartPre=/usr/bin/mkdir -p %h/.urxvt
ExecStartPre=/usr/bin/chmod 700 %h/.urxvt
ExecStartPre=/bin/sh -c 'rm -f %h/.urxvt/urxvtd-*'
ExecStart=/usr/bin/urxvtd -q -o
Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target
UNIT

    chown "$REAL_USER:$REAL_GROUP" "$URXVTD_UNIT"

fi

if [ -d "/run/user/$(id -u "$REAL_USER")" ]; then

    sudo -u "$REAL_USER" XDG_RUNTIME_DIR="/run/user/$(id -u "$REAL_USER")" \
        systemctl --user daemon-reload

    sudo -u "$REAL_USER" XDG_RUNTIME_DIR="/run/user/$(id -u "$REAL_USER")" \
        systemctl --user enable urxvtd.service

fi

# ------------------------------------------------------------
# Utilities
# ------------------------------------------------------------

echo
echo "==> Installing utilities..."

apt-get install -y --no-install-recommends \
    vim \
    git \
    xsel \
    xclip \
    xautolock \
    feh \
    curl \
    wget \
    ca-certificates \
    tmux \
    htop

# ------------------------------------------------------------
# X utilities
#
# x11-xserver-utils -> xrdb, xset, xrandr
# x11-xkb-utils     -> setxkbmap
#
# ~/.xinitrc calls "xrdb" to load ~/.Xdefaults and "xset" to set
# the key repeat rate.  ~/.i3/scripts/{i3stat,laptop,dblmon}
# call "xrandr".  i3 itself calls "setxkbmap" for layout switching.
# ------------------------------------------------------------

echo
echo "==> Installing X utilities..."

apt-get install -y --no-install-recommends \
    x11-xserver-utils \
    x11-xkb-utils

# ------------------------------------------------------------
# dmenu (program launcher, bound to Super+d in i3)
#
# NOTE: Ubuntu 26.04 dropped the standalone "dmenu" package.
# It is now shipped by "suckless-tools", which Provides: dmenu
# and installs /usr/bin/dmenu and /usr/bin/dmenu_run.
# ------------------------------------------------------------

echo
echo "==> Installing dmenu (suckless-tools)..."

apt-get install -y --no-install-recommends \
    suckless-tools

# ------------------------------------------------------------
# Build toolchain
#
# YouCompleteMe (declared in ~/.vimrc) is a C++ extension and
# cannot be compiled without a toolchain.
# ------------------------------------------------------------

echo
echo "==> Installing build toolchain (for YouCompleteMe)..."

apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    pkg-config

# ------------------------------------------------------------
# NetworkManager
# ------------------------------------------------------------

echo
echo "==> Installing NetworkManager..."

apt-get install -y --no-install-recommends \
    network-manager \
    network-manager-gnome

systemctl enable NetworkManager
systemctl restart NetworkManager

# ------------------------------------------------------------
# LightDM
# ------------------------------------------------------------

echo
echo "==> Installing LightDM..."

apt-get install -y --no-install-recommends \
    lightdm

systemctl enable lightdm

# ------------------------------------------------------------
# Google Chrome
# ------------------------------------------------------------

echo
echo "==> Installing Google Chrome..."

CHROME_DEB="/tmp/google-chrome-stable_current_amd64.deb"

wget \
    -O "$CHROME_DEB" \
    "https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb"

apt-get install -y "$CHROME_DEB"

rm -f "$CHROME_DEB"

# ------------------------------------------------------------
# Vundle
#
# ~/.vim/bundle must be owned by the real user, otherwise the
# plugins that Vundle installs into it cannot be written.
# ------------------------------------------------------------

echo
echo "==> Installing Vundle..."

install -d -m 755 -o "$REAL_USER" -g "$REAL_GROUP" "$REAL_HOME/.vim/bundle"

if [ ! -d "$REAL_HOME/.vim/bundle/Vundle.vim" ]; then

    sudo -u "$REAL_USER" git clone \
        https://github.com/VundleVim/Vundle.vim.git \
        "$REAL_HOME/.vim/bundle/Vundle.vim"

else

    echo "Vundle already installed."

fi

# YouCompleteMe has to be compiled against the local toolchain.
# It is pulled in by ":PluginInstall" from inside vim.

if [ ! -d "$REAL_HOME/.vim/bundle/YouCompleteMe" ]; then

    echo
    echo "NOTE: YouCompleteMe is not installed yet."
    echo "      Run ':PluginInstall' inside vim to fetch and build it."

fi

# ------------------------------------------------------------
# Enable graphical boot
# ------------------------------------------------------------

echo
echo "==> Setting graphical target..."

systemctl set-default graphical.target

# ------------------------------------------------------------
# Verification
# ------------------------------------------------------------

echo
echo "==> Verifying installation..."

MISSING=""

for cmd in urxvt urxvtc urxvtd xrdb xset xrandr setxkbmap dmenu dmenu_run \
           i3 i3status i3lock xautolock feh xsel xclip vim git; do

    if ! command -v "$cmd" >/dev/null 2>&1; then
        MISSING="$MISSING $cmd"
    fi

done

if [ -n "$MISSING" ]; then
    echo
    echo "WARNING: missing commands:$MISSING"
else
    echo "All required commands are present."
fi

# ------------------------------------------------------------
# DO NOT TOUCH USER CONFIGURATION
# ------------------------------------------------------------

echo
echo "============================================================"
echo " User configuration was NOT modified"
echo "============================================================"
echo
echo "Existing i3 configuration was left untouched."
echo
echo "No files were created or modified in:"
echo
echo "    $REAL_HOME/.i3"
echo "    $REAL_HOME/.config/i3"
echo "    $REAL_HOME/.Xdefaults"
echo "    $REAL_HOME/.xinitrc"
echo
echo "============================================================"
echo
echo " Installed:"
echo
echo "    Xorg"
echo "    i3"
echo "    i3status"
echo "    i3lock"
echo "    urxvt / urxvtc / urxvtd"
echo "    dmenu (suckless-tools)"
echo "    Vim"
echo "    Git"
echo "    xsel / xclip"
echo "    xautolock"
echo "    feh"
echo "    xrdb / xset / xrandr (x11-xserver-utils)"
echo "    setxkbmap (x11-xkb-utils)"
echo "    build-essential / cmake"
echo "    tmux"
echo "    htop"
echo "    NetworkManager"
echo "    nm-applet"
echo "    LightDM"
echo "    Google Chrome"
echo "    Vundle"
echo
echo "============================================================"
echo
echo "Reboot with:"
echo
echo "    sudo reboot"
echo
echo "============================================================"
